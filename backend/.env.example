# Hunar Voice AI
HUNAR_API_KEY=changeme
# Base host only -- the client appends /external/v1 itself
HUNAR_API_BASE_URL=https://api.voice.hunar.ai
HUNAR_WEBHOOK_SECRET=changeme
# Optional: a validated org number from GET /external/v1/numbers/. Leave blank to use the account default.
HUNAR_FROM_PHONE_NUMBER=

# People Data Labs
PDL_API_KEY=changeme

# OpenRouter (used for JD parsing + optional qualitative scoring)
OPENROUTER_API_KEY=changeme
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Public base URL of THIS backend, used to build webhook callback URLs
# (must be publicly reachable, e.g. the Railway deployment URL)
PUBLIC_BASE_URL=https://your-backend.up.railway.app

# Database
DATABASE_URL=sqlite:///./hunar.db

# CORS
FRONTEND_ORIGIN=http://localhost:3000
